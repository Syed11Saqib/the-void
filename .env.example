# ── SUPABASE (Auth + Database) ──────────────────────────────────────────────
# 1. Go to https://supabase.com -> New Project (free tier)
# 2. Project Settings -> API -> copy "Project URL" and "anon public" key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> "service_role" key (server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# In Supabase Dashboard -> Authentication -> Providers -> Google
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Add the Supabase callback URL shown there into Google's "Authorized redirect URIs"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OPENROUTER (LLM for symptom analysis) ───────────────────────────────────
# 1. Go to https://openrouter.ai -> Sign up (free)
# 2. Keys -> Create Key
# 3. Free models available, e.g. "meta-llama/llama-3.1-8b-instruct:free"
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── MAPS (no key needed) ────────────────────────────────────────────────────
# OpenStreetMap Overpass API is free, public, no key required.
# Default public endpoint used in lib/services/overpass.ts:
# https://overpass-api.de/api/interpreter
NEXT_PUBLIC_OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── APP ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
